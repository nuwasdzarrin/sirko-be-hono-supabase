# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# WAJIB pakai POOLER Supabase (Supavisor) mode transaction, port 6543 — BUKAN 5432.
# Format: postgresql://<user>:<pass>@<host>:6543/postgres?pgbouncer=true
# Portabilitas: pindah ke Postgres VPS = cukup ganti string ini, kode tak berubah.
DATABASE_URL=postgresql://postgres.abcdefgh:password@aws-0-region.pooler.supabase.com:6543/postgres

# ─── Auth (self-owned JWT) ───────────────────────────────────────────────────
# Gunakan secret acak panjang (mis. `openssl rand -base64 48`). JANGAN commit nilai asli.
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_REFRESH_SECRET=ganti-dengan-secret-acak-lain-minimal-32-karakter

# ─── Storage media (Cloudflare R2, protokol S3) ──────────────────────────────
# Wajib diisi saat APP_ENV=production; boleh kosong saat development.
# R2: Cloudflare → R2 → Manage API tokens → "Object Read & Write" khusus bucket sirko-media.
# Account ID ada di URL dashboard (dash.cloudflare.com/<ACCOUNT_ID>/r2/...).
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=sirko-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL publik bucket TANPA garis miring akhir. Disarankan custom domain (Settings → Custom
# Domains, mis. https://media.sirkopos.com); r2.dev hanya untuk uji (dibatasi Cloudflare).
S3_PUBLIC_BASE_URL=https://media.sirkopos.com
# Folder lingkungan di bucket: dev | staging | prod → objek = <STORAGE_ENV>/<scope>/...
#   prod/catalog/…        foto Katalog Umum
#   prod/product/…        upload app (signed URL)
#   prod/site/YYYY/MM/…   gambar artikel situs
#   prod/config/…         QRIS top-up Poin & langganan
# Kosong → prod bila APP_ENV=production, selain itu dev.
STORAGE_ENV=dev

# ─── Migrasi media sekali jalan (npm run migrate:media-r2) ───────────────────
# Kredensial storage LAMA (sumber). Hapus dari .env setelah migrasi selesai.
# MEDIA_SRC_S3_ENDPOINT=https://<project>.storage.supabase.co/storage/v1/s3
# MEDIA_SRC_S3_REGION=ap-southeast-1
# MEDIA_SRC_S3_BUCKET=sirko-media
# MEDIA_SRC_S3_ACCESS_KEY_ID=
# MEDIA_SRC_S3_SECRET_ACCESS_KEY=
# MEDIA_SRC_S3_PUBLIC_BASE_URL=https://<project>.storage.supabase.co/storage/v1/object/public/sirko-media

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development

# ─── Dashboard admin (opsional) ──────────────────────────────────────────────
# Bila keduanya diisi, halaman /dashboard digerbang Basic Auth. Kosong = terbuka (dev).
DASHBOARD_USER=
DASHBOARD_PASSWORD=

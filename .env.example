# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# WAJIB pakai POOLER Supabase (Supavisor) mode transaction, port 6543 — BUKAN 5432.
# Format: postgresql://<user>:<pass>@<host>:6543/postgres?pgbouncer=true
# Portabilitas: pindah ke Postgres VPS = cukup ganti string ini, kode tak berubah.
DATABASE_URL=postgresql://postgres.abcdefgh:password@aws-0-region.pooler.supabase.com:6543/postgres

# ─── Auth (self-owned JWT) ───────────────────────────────────────────────────
# Gunakan secret acak panjang (mis. `openssl rand -base64 48`). JANGAN commit nilai asli.
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_REFRESH_SECRET=ganti-dengan-secret-acak-lain-minimal-32-karakter

# ─── Storage (S3-compatible) — dipakai mulai Fitur 2 (Media) ──────────────────
# Wajib diisi saat APP_ENV=production; boleh kosong saat development.
S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=sirko-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL publik dasar objek. Supabase: https://<project>.supabase.co/storage/v1/object/public/<bucket>
# Bila kosong → dipakai `${S3_ENDPOINT}/${S3_BUCKET}` (pola MinIO/VPS).
S3_PUBLIC_BASE_URL=

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development

# ─── Dashboard admin (opsional) ──────────────────────────────────────────────
# Bila keduanya diisi, halaman /dashboard digerbang Basic Auth. Kosong = terbuka (dev).
DASHBOARD_USER=
DASHBOARD_PASSWORD=

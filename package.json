{
  "name": "sirko-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sirko backend — Hono @ Vercel + PostgreSQL (portable, no Supabase SDK). Foundation phase.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/dev-server.ts",
    "migrate": "node --env-file=.env --import tsx src/db/migrate-cli.ts",
    "migrate:prod": "node --env-file=.env.production.local --import tsx src/db/migrate-cli.ts",
    "seed:catalog": "node --env-file=.env --import tsx src/db/seed-catalog.ts",
    "seed:catalog:prod": "node --env-file=.env.production.local --import tsx src/db/seed-catalog.ts",
    "reclassify:catalog": "node --env-file=.env --import tsx src/db/reclassify-catalog.ts",
    "reclassify:catalog:prod": "node --env-file=.env.production.local --import tsx src/db/reclassify-catalog.ts",
    "export:catalog": "node --env-file=.env --import tsx src/db/export-catalog-assets.ts",
    "export:catalog:prod": "node --env-file=.env.production.local --import tsx src/db/export-catalog-assets.ts",
    "mirror:catalog": "node --env-file=.env --import tsx src/db/mirror-catalog-photos.ts",
    "mirror:catalog:prod": "node --env-file=.env.production.local --import tsx src/db/mirror-catalog-photos.ts",
    "curate:catalog": "node data/curate-catalog.js",
    "curate:catalog:apply": "node --env-file=.env.production.local data/curate-catalog.js --apply",
    "build:seed": "node data/build-seed.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "bcryptjs": "^2.4.3",
    "ejs": "^3.1.10",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.10.2",
    "better-sqlite3": "^13.0.3",
    "sharp": "^0.35.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
